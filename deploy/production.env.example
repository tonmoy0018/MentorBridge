# Production configuration for deploy/docker-compose.prod.yml. Copy to deploy/.env on the
# server (git-ignored) and fill in real values. NEVER commit the filled-in file.

# Public host name (DNS A/AAAA record must point at this server) and the TLS contact address.
SITE_DOMAIN=mentorbridge.example.com
ACME_EMAIL=ops@example.com

# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Optional: a less guessable path for Django admin (must end with "/").
DJANGO_ADMIN_URL=django-admin/

POSTGRES_DB=mentorbridge
POSTGRES_USER=mentorbridge
# Long random value.
POSTGRES_PASSWORD=

# Transactional email (SMTP). Required: verification and password-reset emails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MentorBridge <no-reply@mentorbridge.example.com>

# Marketplace rules.
PLATFORM_CURRENCY=USD
PLATFORM_FEE_BPS=1500
REQUIRE_VERIFIED_EMAIL=true

# Payments: leave empty until a provider is chosen and tested in its sandbox (docs/PAYMENTS.md).
# Live keys (sk_live_...) make payments real.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

GUNICORN_WORKERS=3
LOG_LEVEL=INFO
