# Copy to .env (git-ignored) to override the development defaults in docker-compose.yml.
# Never commit real secrets. Production values come from your hosting platform's secret store.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me-0123456789abcdef
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Public origin of the web app (Next.js proxies /api/* to Django): required for CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only for deliberate cross-origin API clients; the web app is same-origin and needs none.
CORS_ALLOWED_ORIGINS=
# Number of trusted proxies in front of Django (used for client IPs in rate limiting).
NUM_PROXIES=1
SESSION_COOKIE_AGE_SECONDS=1209600

# --- Database (docker compose) ---
POSTGRES_DB=mentorbridge
POSTGRES_USER=mentorbridge
POSTGRES_PASSWORD=mentorbridge
POSTGRES_HOST_PORT=5433

# --- Email (dev: Mailpit at http://localhost:8025) ---
DEFAULT_FROM_EMAIL=MentorBridge <no-reply@mentorbridge.local>
FRONTEND_URL=http://localhost:3000
REQUIRE_VERIFIED_EMAIL=false

# --- Marketplace rules ---
PLATFORM_CURRENCY=USD
PLATFORM_FEE_BPS=1500
# Slot hold while the student pays. Stripe Checkout needs >= 30 min; checkout extends it to 31.
BOOKING_HOLD_MINUTES=30
MENTOR_RESPONSE_HOURS=48
FREE_CANCELLATION_HOURS=24
# Extra minutes before an unpaid hold expires, for a webhook that arrives just after the hold ends.
PAYMENT_WEBHOOK_GRACE_MINUTES=5

# --- Payments (docs/PAYMENTS.md) ---
# Empty = payments off: paid sessions can't be booked. "stripe" is the only adapter implemented.
# The business's country decides the provider; Stripe only works for supported countries
# (docs/PAYMENTS.md §1). Use TEST keys (sk_test_..., whsec_...) outside production. A key
# starting sk_live_/rk_live_ makes payments real. Never commit keys.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
# From the Stripe dashboard (or `stripe listen`) for the endpoint /api/v1/payments/webhooks/stripe/
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE is for automated tests against stripe-mock only; production refuses to start with it.

# --- Frontend (read by Next.js; see frontend/.env.example) ---
INTERNAL_API_URL=http://localhost:8000
